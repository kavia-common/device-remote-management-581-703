# E2E Test Environment Variables
# Copy this to .env.e2e and configure for your environment

# Base URL for the application under test
E2E_BASE_URL=http://localhost:3000

# Backend API URL (if different from base URL)
E2E_API_BASE_URL=http://localhost:8080/api/v1

# Test user credentials (for non-mocked auth scenarios)
E2E_TEST_USER_EMAIL=test@example.com
E2E_TEST_USER_PASSWORD=TestPassword123

# Test admin credentials
E2E_ADMIN_USER_EMAIL=admin@example.com
E2E_ADMIN_USER_PASSWORD=AdminPassword123

# CI mode flag
CI=false

# Headless mode
HEADLESS=true

# Screenshot and video recording
PLAYWRIGHT_SCREENSHOT=on-failure
PLAYWRIGHT_VIDEO=retain-on-failure

# Timeout settings (milliseconds)
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT=15000

# Browser selection (chromium, firefox, webkit)
PLAYWRIGHT_BROWSER=chromium

# Number of workers (parallel test execution)
PLAYWRIGHT_WORKERS=1

# Retry count
PLAYWRIGHT_RETRIES=2
