# Frontend Application - Environment Variables Example
# Copy this file to `.env` (or `.env.development.local` for local-only overrides)
# and adjust values as needed. Create React App only exposes variables prefixed with REACT_APP_.

# Base URL for backend API. Include the path prefix if your backend serves under /api/v1.
# Example values:
#  - http://localhost:8080/api/v1 (local)
#  - https://staging-api.devicemanagement.com/api/v1 (staging)
#  - https://api.devicemanagement.com/api/v1 (production)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# Current environment name. Not used by React build, but available for your app logic.
# Suggested values: development | staging | production
REACT_APP_ENV=development

# Default polling interval in milliseconds for background refresh (e.g. jobs polling)
# Typical values: 5000 - 15000
REACT_APP_POLL_INTERVAL_MS=10000

# Feature flags: JSON object or comma-separated list of flags you want to enable.
# Supported formats:
#  - JSON: {"newJobUI":true,"snmpV3":true}
#  - CSV:  newJobUI,snmpV3
REACT_APP_FEATURE_FLAGS=
