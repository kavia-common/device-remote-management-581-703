# API Configuration
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_API_TIMEOUT=30000

# Realtime Updates Configuration
# Mode: 'sse' (Server-Sent Events) or 'ws' (WebSocket)
# Default: sse
REACT_APP_REALTIME_MODE=sse

# Realtime endpoint path (relative to API base URL)
# Default: /realtime/events
REACT_APP_REALTIME_ENDPOINT=/realtime/events

# Site URL for email redirects (used by Supabase and other services)
# This will be automatically configured during deployment
REACT_APP_SITE_URL=http://localhost:3000
