# Frontend configuration

# Base URL for backend API, e.g. http://localhost:8080/api/v1
REACT_APP_API_URL=http://localhost:8080/api/v1

# Public site URL used by backend for email redirect (signup, password reset)
# e.g. http://localhost:3000
REACT_APP_SITE_URL=http://localhost:3000

# Axios timeout in milliseconds
REACT_APP_API_TIMEOUT=15000

# Realtime protocol: sse or ws (ws reserved for future use)
REACT_APP_REALTIME_PROTOCOL=sse

# Enable verbose frontend logging for debugging (true/false)
REACT_APP_DEBUG=false
