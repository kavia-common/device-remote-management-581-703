# Frontend React environment
# Copy this file to .env (or .env.development.local) for local development.

# Backend API base URL (must include /api/v1)
REACT_APP_API_BASE_URL=http://localhost:8080/api/v1

# Optional: environment name
REACT_APP_ENV=development

# Optional: polling interval for background hooks (ms)
REACT_APP_POLL_INTERVAL_MS=10000

# Optional: feature flags as JSON or CSV
# REACT_APP_FEATURE_FLAGS={"newJobUI":true}
# REACT_APP_FEATURE_FLAGS=newJobUI,snmpV3
