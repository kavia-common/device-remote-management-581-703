{
  "openapi": "3.0.3",
  "info": {
    "title": "Device Remote Management - Frontend API",
    "version": "1.0.0",
    "description": "OpenAPI placeholder for frontend integration. Replace with backend API spec when available."
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "timestamp"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "array", "items": { "type": "string" } },
              "timestamp": { "type": "string", "format": "date-time" },
              "path": { "type": "string" }
            }
          }
        }
      },
      "PaginationResponse": {
        "type": "object",
        "required": ["page", "pageSize", "totalPages", "totalItems"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
          "totalPages": { "type": "integer", "minimum": 0 },
          "totalItems": { "type": "integer", "minimum": 0 },
          "hasNext": { "type": "boolean" },
          "hasPrevious": { "type": "boolean" }
        }
      }
    }
  }
}
