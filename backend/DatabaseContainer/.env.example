# PostgreSQL base configuration (used by docker-compose.yml)
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application database/user created on first init by init/01_init.sql
APP_DB_NAME=drm_app
APP_DB_USER=drm_user
APP_DB_PASSWORD=drm_password

# Standard DATABASE_URL for backend services to consume (do NOT hardcode in code)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# For local docker-compose (service name "db"): HOST=db; for direct localhost: use localhost
DATABASE_URL=postgresql://drm_user:drm_password@localhost:5432/drm_app
