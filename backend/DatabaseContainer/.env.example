# PostgreSQL container environment for local development

# Postgres superuser/bootstrap
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application database/role created by init scripts
APP_DB_NAME=drm_app
APP_DB_USER=drm_user
APP_DB_PASSWORD=drm_password

# Standard DSN used by backend services (host=localhost for host access; host=db for compose network)
# Uncomment one of the lines below as needed.
# DATABASE_URL=postgresql://drm_user:drm_password@localhost:5432/drm_app
# DATABASE_URL=postgresql://drm_user:drm_password@db:5432/drm_app
