# Environment
NODE_ENV=development

# Server
PORT=8080
API_BASE_PATH=/api/v1

# Database & Queue
# Use a proper DSN in non-dev environments. Do not commit secrets to source control.
DATABASE_URL=postgresql://drm_user:drm_password@db:5432/drm_app
REDIS_URL=redis://redis:6379

# Authentication
# Use either a symmetric secret (JWT_SECRET) or RSA keys (JWT_PRIVATE_KEY/JWT_PUBLIC_KEY).
# If RSA keys are provided, JWT_SECRET will be ignored.
JWT_SECRET=please_change_in_prod
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY should be provided as single-line PEM values with \n escaped, or loaded via orchestrator.
# Example:
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Security
# Comma-separated origins or "*" for all (dev only). Examples:
# CORS_ORIGIN=http://localhost:3000,https://staging.example.com
CORS_ORIGIN=http://localhost:3000

# External Protocol Services
# ECO ACS (TR-069), WebPA, USP service base URLs.
ECO_ACS_URL=http://localhost:9001
WEBPA_URL=http://localhost:9002
USP_URL=http://localhost:9003

# Password hashing (bcrypt)
# Default 12 for dev; increase for prod depending on performance.
PASSWORD_SALT_ROUNDS=12
