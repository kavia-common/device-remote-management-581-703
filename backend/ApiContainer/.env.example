# Backend API (Node/TypeScript) environment

# Service settings
PORT=8080
API_BASE_PATH=/api/v1

# CORS: allow frontend origin(s), comma-separated. For local dev:
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=change_me_in_dev

# Database
# For local host access:
# DATABASE_URL=postgresql://drm_user:drm_password@localhost:5432/drm_app
# For docker-compose network (service name "db"):
# DATABASE_URL=postgresql://drm_user:drm_password@db:5432/drm_app

# Redis (optional for job queue in this template)
# REDIS_URL=redis://localhost:6379
