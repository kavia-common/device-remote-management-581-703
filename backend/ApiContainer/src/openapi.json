{
  "openapi": "3.0.3",
  "info": {
    "title": "Device Remote Management - Backend API",
    "version": "1.0.1",
    "description": "RESTful API for the Device Remote Management platform. Serves operations across SNMP, WebPA, TR69/ACS, and TR369/USP with multi-tenant isolation.",
    "contact": {
      "name": "API Support",
      "email": "api-support@devicemanagement.com"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    { "url": "http://localhost:8080/api/v1", "description": "Local development" }
  ],
  "tags": [
    { "name": "Help & Metadata", "description": "Health and metadata" },
    { "name": "Authentication", "description": "Login and token management" },
    { "name": "Users", "description": "User profile management" },
    { "name": "Devices", "description": "Device management with pagination and tenant scoping" },
    { "name": "Jobs", "description": "Asynchronous operations" },
    { "name": "SNMP Protocol", "description": "SNMP operations" },
    { "name": "WebPA Protocol", "description": "WebPA operations" },
    { "name": "TR69 Protocol", "description": "TR69/ACS operations" },
    { "name": "TR369 Protocol", "description": "TR369/USP operations" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns liveness and integration presence.",
        "tags": ["Help & Metadata"],
        "responses": {
          "200": {
            "description": "Service healthy"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login (stub)",
        "description": "Validates credentials and returns JWT tokens (demo implementation).",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": { "email": { "type": "string" }, "password": { "type": "string" } }, "required": ["email","password"] }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": {
                  "accessToken": { "type": "string" },
                  "refreshToken": { "type": "string" },
                  "user": { "type": "object" }
                } } }
            }
          },
          "400": { "description": "Invalid request" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "description": "Exchanges a valid refresh token for a new access token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } }, "required": ["refreshToken"] } }
          }
        },
        "responses": {
          "200": { "description": "New access token", "content": { "application/json": { "schema": { "type": "object", "properties": { "accessToken": { "type": "string" } } } } } },
          "400": { "description": "Invalid request" },
          "401": { "description": "Invalid or expired refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout (revoke refresh)",
        "description": "Revokes a provided refresh token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } } } } }
        },
        "responses": {
          "204": { "description": "Logged out" }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Get current user profile",
        "tags": ["Users"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "summary": "Update current user profile",
        "tags": ["Users"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "name": { "type": "string" } } } } }
        },
        "responses": {
          "200": { "description": "Updated user profile" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/devices": {
      "get": {
        "summary": "List devices (paginated)",
        "tags": ["Devices"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Devices list with pagination" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create device",
        "tags": ["Devices"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["name","identifier"], "properties": {
                "name": { "type": "string" },
                "identifier": { "type": "string" },
                "mgmt_address": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
              } }
            }
          }
        },
        "responses": {
          "201": { "description": "Device created" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Identifier conflict" }
        }
      }
    },
    "/devices/{id}": {
      "get": {
        "summary": "Get device by id",
        "tags": ["Devices"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Device" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Update device",
        "tags": ["Devices"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "properties": {
                "name": { "type": "string" },
                "identifier": { "type": "string" },
                "mgmt_address": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } }
              } }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated device" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" },
          "409": { "description": "Identifier conflict" }
        }
      },
      "delete": {
        "summary": "Delete device",
        "tags": ["Devices"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/jobs": {
      "get": {
        "summary": "List jobs",
        "description": "Returns the current tenant's jobs with live status and progress from the queue backend (Redis or in-memory).",
        "tags": ["Jobs"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Jobs list with live status" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "summary": "Get job by id",
        "description": "Returns job details including status, progress, and protocol results if available.",
        "tags": ["Jobs"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Job detail with status and results" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/protocols/snmp/get": {
      "post": {
        "summary": "Queue SNMP GET operation",
        "description": "Validates SNMP GET request and enqueues a job. Returns a jobId.",
        "tags": ["SNMP Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/SnmpOperationGet" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/snmp/set": {
      "post": {
        "summary": "Queue SNMP SET operation",
        "description": "Validates SNMP SET request and enqueues a job. Returns a jobId.",
        "tags": ["SNMP Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/SnmpOperationSet" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/snmp/walk": {
      "post": {
        "summary": "Queue SNMP WALK operation",
        "description": "Validates SNMP WALK request and enqueues a job. Returns a jobId.",
        "tags": ["SNMP Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/SnmpOperationWalk" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/webpa/get": {
      "post": {
        "summary": "Queue WebPA GET operation",
        "tags": ["WebPA Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/WebpaGet" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/webpa/set": {
      "post": {
        "summary": "Queue WebPA SET operation",
        "tags": ["WebPA Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/WebpaSet" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/tr69/get": {
      "post": {
        "summary": "Queue TR69 GetParameterValues",
        "tags": ["TR69 Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/Tr69Get" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/tr69/set": {
      "post": {
        "summary": "Queue TR69 SetParameterValues",
        "tags": ["TR69 Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/Tr69Set" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/tr369/get": {
      "post": {
        "summary": "Queue TR369 Get command",
        "tags": ["TR369 Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/Tr369Get" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/protocols/tr369/set": {
      "post": {
        "summary": "Queue TR369 Set command",
        "tags": ["TR369 Protocol"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": { "$ref": "#/components/requestBodies/Tr369Set" },
        "responses": { "202": { "$ref": "#/components/responses/EnqueueAccepted" }, "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT authentication token"
      }
    },
    "schemas": {
      "SnmpCommon": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "description": "Target host or IP" },
          "version": { "type": "string", "enum": ["v2c","v3"] },
          "community": { "type": "string", "description": "SNMP community for v2c" },
          "username": { "type": "string", "description": "SNMP v3 username" },
          "authProtocol": { "type": "string", "enum": ["none","MD5","SHA"], "default": "none" },
          "authPassword": { "type": "string" },
          "privProtocol": { "type": "string", "enum": ["none","DES","AES"], "default": "none" },
          "privPassword": { "type": "string" },
          "oids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["target","version","oids"]
      },
      "WebpaBase": {
        "type": "object",
        "properties": {
          "deviceId": { "type": "string" },
          "parameters": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["deviceId","parameters"]
      },
      "Tr69Base": {
        "type": "object",
        "properties": {
          "deviceId": { "type": "string" },
          "parameters": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["deviceId","parameters"]
      },
      "Tr369Base": {
        "type": "object",
        "properties": {
          "endpointId": { "type": "string" },
          "parameters": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["endpointId","parameters"]
      },
      "EnqueueResponse": {
        "type": "object",
        "properties": { "jobId": { "type": "string" } },
        "required": ["jobId"]
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code","message","timestamp"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "oneOf": [ { "type": "array", "items": { "type": "string" } }, { "type": "object" } ] },
              "timestamp": { "type": "string", "format": "date-time" },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "requestBodies": {
      "SnmpOperationGet": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/SnmpCommon" },
                { "type": "object", "properties": { "operation": { "type": "string", "enum": ["get"] } }, "required": ["operation"] }
              ]
            }
          }
        }
      },
      "SnmpOperationSet": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/SnmpCommon" },
                { "type": "object", "properties": { "operation": { "type": "string", "enum": ["set"] }, "values": { "type": "object" } }, "required": ["operation","values"] }
              ]
            }
          }
        }
      },
      "SnmpOperationWalk": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/SnmpCommon" },
                { "type": "object", "properties": { "operation": { "type": "string", "enum": ["walk"] } }, "required": ["operation"] }
              ]
            }
          }
        }
      },
      "WebpaGet": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/WebpaBase" },
                { "type": "object", "properties": { "action": { "type": "string", "enum": ["get"] } }, "required": ["action"] }
              ]
            }
          }
        }
      },
      "WebpaSet": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/WebpaBase" },
                { "type": "object", "properties": { "action": { "type": "string", "enum": ["set"] }, "values": { "type": "object" } }, "required": ["action","values"] }
              ]
            }
          }
        }
      },
      "Tr69Get": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/Tr69Base" },
                { "type": "object", "properties": { "action": { "type": "string", "enum": ["GetParameterValues"] } }, "required": ["action"] }
              ]
            }
          }
        }
      },
      "Tr69Set": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/Tr69Base" },
                { "type": "object", "properties": { "action": { "type": "string", "enum": ["SetParameterValues"] }, "values": { "type": "object" } }, "required": ["action","values"] }
              ]
            }
          }
        }
      },
      "Tr369Get": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/Tr369Base" },
                { "type": "object", "properties": { "command": { "type": "string", "enum": ["Get"] } }, "required": ["command"] }
              ]
            }
          }
        }
      },
      "Tr369Set": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                { "$ref": "#/components/schemas/Tr369Base" },
                { "type": "object", "properties": { "command": { "type": "string", "enum": ["Set"] }, "payload": { "type": "object" } }, "required": ["command","payload"] }
              ]
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input data or validation errors",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid authentication token",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "EnqueueAccepted": {
        "description": "Job enqueued",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EnqueueResponse" } } }
      }
    }
  }
}
